package simple

import (
	"errors"
	"fmt"
	"path/filepath"
	"strings"
	"time"
)

// File status values stored in FileEntry.Status. The string values have
// been stable since manifest V1; the constants only give them names so
// consumers stop hard-coding literals.
const (
	FileStatusNew       = "new"
	FileStatusChanged   = "changed"
	FileStatusUnchanged = "unchanged"
	FileStatusLocked    = "locked"
	FileStatusError     = "error"
)

// SnapshotCompleteness is the explicit completeness state of a snapshot.
// It is serialized in the manifest. Manifests written before the field
// existed derive it from their contents (see DeriveCompleteness), so no
// migration is required.
type SnapshotCompleteness string

const (
	SnapshotComplete   SnapshotCompleteness = "complete"
	SnapshotIncomplete SnapshotCompleteness = "incomplete"
)

// IsRestorable reports whether the file entry carries enough information
// to be restored: it must not be locked or errored and must have a
// content hash. Consumers must use this instead of ad-hoc checks on
// Status strings and empty hashes.
func (f *FileEntry) IsRestorable() bool {
	if f == nil {
		return false
	}
	if f.Status == FileStatusLocked || f.Status == FileStatusError {
		return false
	}
	return f.ContentHash != ""
}

// DeriveCompleteness computes snapshot completeness from manifest
// contents. Used for manifests written before the explicit Completeness
// field existed: any scan errors, locked files, or failed files make the
// snapshot incomplete.
func (m *Manifest) DeriveCompleteness() SnapshotCompleteness {
	if m == nil {
		return SnapshotIncomplete
	}
	if m.Stats.ScanErrors > 0 {
		return SnapshotIncomplete
	}
	for _, d := range m.Dirs {
		for i := range d.Files {
			f := &d.Files[i]
			if f.Status == FileStatusLocked || f.Status == FileStatusError {
				return SnapshotIncomplete
			}
		}
	}
	return SnapshotComplete
}

// EffectiveCompleteness returns the explicit completeness state when the
// manifest carries one, deriving it from contents otherwise. All
// consumers must use this (or IsComplete) instead of guessing from
// ScanErrors or file statuses.
func (m *Manifest) EffectiveCompleteness() SnapshotCompleteness {
	if m != nil && m.Completeness != "" {
		return m.Completeness
	}
	return m.DeriveCompleteness()
}

// IsComplete reports whether the snapshot is complete (no scan errors,
// no locked or failed files).
func (m *Manifest) IsComplete() bool {
	return m.EffectiveCompleteness() == SnapshotComplete
}

// Validate checks all manifest invariants: header sanity plus structural
// integrity. Use it on manifests the process just built (before saving)
// and anywhere full strictness is wanted.
func (m *Manifest) Validate() error {
	if m == nil {
		return errors.New("manifest is nil")
	}
	if m.Version < 2 {
		return fmt.Errorf("unsupported manifest version %d", m.Version)
	}
	if m.SourceID <= 0 {
		return fmt.Errorf("manifest sourceId must be positive, got %d", m.SourceID)
	}
	if strings.TrimSpace(m.SourcePath) == "" {
		return errors.New("manifest sourcePath is empty")
	}
	if strings.TrimSpace(m.DeviceID) == "" {
		return errors.New("manifest deviceId is empty")
	}
	if m.Timestamp != "" {
		if _, err := time.Parse(time.RFC3339, m.Timestamp); err != nil {
			return fmt.Errorf("manifest timestamp %q is not RFC3339: %w", m.Timestamp, err)
		}
	}
	if m.CloudID != "" {
		if err := validateCloudID(m.CloudID); err != nil {
			return fmt.Errorf("manifest cloudId: %w", err)
		}
	}
	return m.ValidateStructure()
}

// ValidateStructure checks the structural invariants that detect
// corruption: path traversal, duplicate and dangling entries, negative
// sizes, chunk/size consistency, and stats drift. Header sanity (version,
// source ID, timestamps) is NOT included: LoadManifestFromData uses this
// method and must keep parsing tolerant, synthetic, and legacy manifests
// (empty objects, V1 migrations, golden fixtures with placeholder hashes).
func (m *Manifest) ValidateStructure() error {
	if m == nil {
		return errors.New("manifest is nil")
	}
	var (
		fileCount int
		totalSize int64
	)
	for dirPath, d := range m.Dirs {
		if err := validateManifestDirKey(dirPath); err != nil {
			return fmt.Errorf("dir key %q: %w", dirPath, err)
		}
		if d == nil {
			return fmt.Errorf("dir %q: nil directory entry", dirPath)
		}
		seenNames := make(map[string]bool, len(d.Files))
		for i := range d.Files {
			f := &d.Files[i]
			if err := validateManifestEntryName(f.Name); err != nil {
				return fmt.Errorf("dir %q file %d: %w", dirPath, i, err)
			}
			if seenNames[f.Name] {
				return fmt.Errorf("dir %q: duplicate file name %q", dirPath, f.Name)
			}
			seenNames[f.Name] = true
			if f.Size < 0 {
				return fmt.Errorf("file %q: negative size %d", f.Name, f.Size)
			}
			var chunkSum int64
			for _, c := range f.Chunks {
				if c.Size < 0 {
					return fmt.Errorf("file %q: negative chunk size %d", f.Name, c.Size)
				}
				chunkSum += c.Size
			}
			if len(f.Chunks) > 0 && f.IsRestorable() && chunkSum != f.Size {
				return fmt.Errorf("file %q: chunk sizes sum to %d but file size is %d", f.Name, chunkSum, f.Size)
			}
			fileCount++
			totalSize += f.Size
		}
		for _, s := range d.SubDirs {
			if err := validateManifestEntryName(s); err != nil {
				return fmt.Errorf("dir %q subdir %q: %w", dirPath, s, err)
			}
			child := s
			if dirPath != "" {
				child = dirPath + "/" + s
			}
			if _, ok := m.Dirs[child]; !ok {
				return fmt.Errorf("dir %q lists subdir %q but it has no directory entry", dirPath, s)
			}
		}
	}
	if m.Stats.FileCount != fileCount {
		return fmt.Errorf("stats fileCount %d does not match %d files in manifest", m.Stats.FileCount, fileCount)
	}
	if m.Stats.TotalSize != totalSize {
		return fmt.Errorf("stats totalSize %d does not match file sum %d", m.Stats.TotalSize, totalSize)
	}
	return nil
}

// validateManifestDirKey checks a Dirs map key: slash-normalized relative
// path, no drive/colon segments, no empty or dot segments. The empty
// string is the root and is always valid.
func validateManifestDirKey(dirPath string) error {
	if dirPath == "" {
		return nil
	}
	if strings.HasPrefix(dirPath, "/") {
		return errors.New("absolute path")
	}
	if strings.ContainsRune(dirPath, '\\') || filepath.IsAbs(dirPath) {
		return errors.New("not a slash-normalized relative path")
	}
	for _, seg := range strings.Split(dirPath, "/") {
		switch {
		case seg == "":
			return errors.New("empty path segment")
		case seg == "." || seg == "..":
			return errors.New("dot path segment")
		case strings.ContainsRune(seg, ':'):
			return errors.New("colon in path segment")
		}
	}
	return nil
}

// validateManifestEntryName checks a file or subdir name: a single path
// segment, no separators, no dot names.
func validateManifestEntryName(name string) error {
	switch {
	case name == "":
		return errors.New("empty name")
	case strings.ContainsAny(name, "/\\"):
		return errors.New("name contains path separator")
	case name == "." || name == "..":
		return errors.New("dot name")
	}
	return nil
}

func isSHA256Hex(s string) bool {
	if len(s) != sha256HexLen {
		return false
	}
	for i := 0; i < len(s); i++ {
		c := s[i]
		if (c < '0' || c > '9') && (c < 'a' || c > 'f') && (c < 'A' || c > 'F') {
			return false
		}
	}
	return true
}

const sha256HexLen = 64
